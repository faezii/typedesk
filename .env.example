# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/typedesk?schema=public"

# Auth.js session signing secret (required) — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# Where uploaded files are stored (relative to project root or absolute)
UPLOAD_DIR="./uploads"

# Company name, TRN, address and VAT rate are stored in the Setting table (seeded; editable in /settings).
