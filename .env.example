# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/typedesk?schema=public"

# Auth.js session signing secret (required) — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# File storage — local disk by default (relative to project root or absolute)
UPLOAD_DIR="./uploads"

# …or an S3-compatible bucket (AWS S3, Cloudflare R2, MinIO). Setting S3_BUCKET switches storage over;
# required on Vercel, whose disk is not persistent. Keep the bucket private: files are served through /api/files.
# S3_BUCKET="typedesk-files"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"   # AWS: https://s3.me-central-1.amazonaws.com
# S3_REGION="auto"                                               # R2: auto · AWS: the bucket's region, e.g. me-central-1
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Company name, CR / tax number, address, logo, VAT rate and invoice terms are stored in the Setting table (editable in /settings).
